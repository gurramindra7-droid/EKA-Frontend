# EKA frontend environment template — copy to .env.local and fill in.
# Never commit real credentials.

# ---- Gateway API -----------------------------------------------------------
# Base URL of the Node/Express gateway (proxies the FastAPI RAG service).
VITE_API_BASE_URL=/api

# Force mock transport while real endpoints are unavailable (default: mock).
# Set to "false" once the gateway is live.
VITE_USE_MOCK=true

# ---- Firebase Authentication ----------------------------------------------
# Leave unset to run in demo-session mode (no real auth calls are made).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
